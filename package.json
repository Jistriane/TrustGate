{
  "name": "trustgate",
  "version": "0.1.0",
  "description": "TrustGate — Stellar x402/MPP task marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:e2e": "jest --config jest.config.js --testPathPattern src/e2e",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:health": "bash scripts/health-check.sh",
    "contracts:build": "ctg build",
    "generate:bindings": "ctg generate --network testnet",
    "deploy:registry": "ts-node --transpile-only scripts/deploy-registry.ts",
    "deploy:smart-account": "ts-node --transpile-only scripts/deploy-smart-account.ts",
    "testnet:setup": "ts-node --transpile-only scripts/testnet-setup.ts",
    "testnet:deploy-registry": "ENV_FILE=.env.testnet ts-node --transpile-only scripts/deploy-registry.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@caatinga/cli": "^3.8.0",
    "@caatinga/core": "^3.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@stellar-agent-kit/core": "^0.1.10",
    "@stellar-agent-kit/plugin-trustless-work": "^0.1.10",
    "@stellar/mpp": "^0.7.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "^2.20.0",
    "@x402/express": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/stellar": "^2.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mppx": "^0.8.15",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}
