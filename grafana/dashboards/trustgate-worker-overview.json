      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(tg_worker_tick_latency_ms_bucket[5m])) by (le, status))",
          "legendFormat": "p95 {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker tick p95 latency (ms)",
      "type": "timeseries"
    },
