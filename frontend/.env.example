# Vite frontend environment variables
# Copy this file to .env.local or .env.development

# API base URL — leave empty to use the Vite dev server proxy
# In production, set this to your backend URL (e.g. https://api.trustgate.example)
VITE_API_URL=

# Network mode — controls whether signed requests are used
# local: no signature auth, secret keys sent directly (dev/CI only)
# testnet: signature auth required, secret keys never sent
# pubnet: signature auth required, secret keys never sent
VITE_NETWORK=local
