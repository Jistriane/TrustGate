NETWORK=local
MOCK_EXTERNALS=false
TG_ALLOW_CLIENT_NONCE=false
# Number of trusted L7 proxies (CDN / load balancer / ingress nginx) directly in
# front of the app. Controls `app.set('trust proxy', N)` which rewrites `req.ip`
# so both the structured request logger and the signature-auth rate-limiter by
# IP trust the correct hop in the X-Forwarded-For chain.
#   0 (default) = no proxy — only the direct peer IP is trusted.
#   1 = Cloudflare only; 2 = Cloudflare + Nginx; etc.
# Required >= 1 when the app is deployed behind any proxy, otherwise IP-based
# rate limits in signatureAuth can be bypassed by spoofing a pre-populated
# X-Forwarded-For header from the attacker side.
TRUST_PROXY_HOPS=0
# NOTE on signed-request canonical body hashing: the built-in express.json()
# middleware keeps the raw request Buffer via the `verify` callback and hands
# that exact wire-format bytes to signatureAuth.ts when computing the SHA-256
# body hash. Do NOT replace this middleware with a custom body parser without
# preserving the `(req as any).rawBody = buf` assignment — otherwise signed
# requests with identical semantic content but different whitespace/field
# ordering will be falsely rejected with 401 invalid signature.
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_HORIZON_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://trustgate:trustgate@localhost:5432/trustgate
WORKER_ENABLED=true
OUTBOX_STREAM_KEY=tg:events
WORKER_POLL_MS=2000
WORKER_MAX_ATTEMPTS=10
OUTBOX_CONSUMER_GROUP=tg-workers
OUTBOX_CONSUMER_NAME=
WEBHOOK_TIMEOUT_MS=5000
# Maximum retries (beyond the initial HTTP attempt) for the result-published webhook
# inside a single Worker tick. Default 3 = up to 4 total HTTP attempts per
# event (1 attempt + 3 retries) with exponential backoff (±50% Full Jitter
# AWS pattern) before re-throwing to let the outer Redis Streams / WORKER_MAX_ATTEMPTS
# take over (10 further retries). Numeric, >=0. WebhookHttpError with
# status 5xx/429/408 + network throws (ECONNRESET, DNS, ETIMEDOUT) qualify for
# retry; non-retryable: 400 401 403 404 410 = throw immediately (no retry).
# 429/503 responses with a Retry-After: N integer header honour N seconds
# (overrides the computed backoff delay when longer).
WEBHOOK_MAX_RETRIES=3
# Base backoff (ms) for the first retry. Subsequent retries double it (1s → 2s
# → 4s with default 1000). Minimum 50 ms.
WEBHOOK_BASE_BACKOFF_MS=1000
RESULT_PUBLISHED_WEBHOOK_URL=

# ============================================================
# SAFETY FEATURES — INCIDENT RESPONSE (P1.8A — MVP Pubnet)
# All booleans accept: 1/true/yes/on or 0/false/no/off (case-insensitive).
# Activate these in under 1 min via rolling restart for P0 incidents.
# ============================================================

# ESCROW_IMPLEMENTATION selects which provider to use for bid collateral.
# Allowed values:
#   trustlesswork (default) — Trustless Work SaaS via plugin-trustless-work.
#       Requires TRUSTLESS_WORK_API_KEY + MARKETPLACE_WALLET + USDC_ISSUER on
#       testnet/pubnet.
#   mock                   — MockEscrowService (no outbound HTTP, all escrow IDs
#       prefixed `mock-escrow:`). Use for CI unit tests with MOCK_EXTERNALS=true.
#   ourown                   — TrustGate-native Soroban escrow WASM at ESCROW_CONTRACT_ID.
#       ⚠️  P0 BLOCKER: NEVER set on testnet/pubnet before ALL of the following are
#       satisfied (safety FEITO DEPLOY + 2 external audits published + TypeScript bindings
#       merged. See ADR 0002 § Fallback exit 15 days checklist. Activating early = loss of
#       real USDC collateral from executors.
ESCROW_IMPLEMENTATION=trustlesswork

# Pause ALL new task creations (POST /tasks local + paid MPP gate path).
# In-flight tasks (ASSIGNED/COMPLETING) still proceed to completion normally.
PAUSE_NEW_TASKS=false

# Pause ALL new bid placements (POST /bids) without affecting any open tasks.
PAUSE_NEW_BIDS=false

# Freeze the Worker's consumption loop. The worker still samples backlog
# metrics (Prometheus continues to see queues grow) and still publishes DB
# rows → Redis Streams, but NEVER dispatches any outbox event (no milestone
# release, no webhook calls, no retries). Safe to toggle off at any time —
# XAUTOCLAIM resumes where it left off with zero data loss.
PAUSE_WORKER_CONSUMPTION=false

# Comma-separated list of Stellar public keys (G...) blocked from bidding AND
# from releasing milestones (task completion for their assigned tasks). The
# on-chain Registry still lists them; this off-chain denylist is the first
# response line to a compromised executor key. Empty string = no denylist.
#
# Example:
# EXECUTOR_DENYLIST=GABC123...,GDEF456...,GGHI789...
EXECUTOR_DENYLIST=

# ---------------- RATE LIMITING (Item 2 / P1-A) ----------------
# Backend storage for sliding-window counters.
#   memory  = in-process (default). Works out of the box; counters reset on
#             pod restart and NOT shared across replicas. Good for dev /
#             single-pod test. NEVER use on prod with >1 replica.
#   redis   = shared, persistent, cross-replica-safe. Requires REDIS_URL to
#             be set to a reachable Redis instance (>= 6.2; see REDIS_URL
#             variable earlier in this file). If REDIS_URL is missing, the
#             application silently falls back to `memory` and logs a WARN.
# Default: memory
RATE_LIMIT_STORAGE=memory

# Emergency "big red switch" (documented in docs/incident-response-runbook.md
# §3.3 / §4.1). Disables ALL rate limiters (they become NO-OPs). Only use
# under P0 incident (e.g. DDoS mitigation upstream in CDN, or shared Redis
# outage where memory fallbacks aren't enough). NEVER leave on past the
# incident window.
# Default: false
RATE_LIMIT_DISABLE_ALL=false

# Fine-grained rpm (requests-per-minute) overrides.
# Empty / unset → use documented defaults (see docs/incident-response-runbook.md
# §4.1 or src/middlewares/rateLimit.ts).
# Negative / non-numeric → same as unset, safe fallback logged.
#   POST /bids                              → default 100 rpm/IP
#   POST /tasks/:id/complete                → default  30 rpm/IP
#   ANY  /webhooks/* (P2.2 placeholder)     → default  60 rpm/IP
RATE_LIMIT_BID_CREATE_RPM=
RATE_LIMIT_TASK_COMPLETE_RPM=
RATE_LIMIT_WEBHOOK_RPM=

# (Required if ESCROW_IMPLEMENTATION=ourown. Deployed Soroban Escrow contract address
# (56+ chars in Soroban address format). Deploy script
# `soroban contract deploy --wasm ... output --rpc http://localhost:8000/soroban/rpc
# Official SDF Testnet Deploy (08/06/2026): CB3XTPXXXF4JSHZBY4S7F3BFD4JZPUVNHDWSDQ7L2JKDUWSK7VBL7YLH
# Explorer Link: https://stellar.expert/explorer/testnet/contract/CB3XTPXXXF4JSHZBY4S7F3BFD4JZPUVNHDWSDQ7L2JKDUWSK7VBL7YLH
ESCROW_CONTRACT_ID=

# (Required if ESCROW_IMPLEMENTATION=ourown. USDC token contract address on Soroban
# (NOT the classic issuer G...; use the Stellar Asset contract
# resulting from wrapping or the deployed contract; 56+ chars). Explicitly
# separated from classic USDC_ISSUER to avoid mapping bugs in pubnet.
# Official SDF Testnet Deploy SAC USDC Circle (canonical wrap):
#   CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
#   Classic issuer: GBBDS5BEUTSEVQHN2GJ4H7VYJ5B2Q2XU4VVC7EERKMOV5QQQHMK6FLA5
# Explorer Link: https://stellar.expert/explorer/testnet/contract/CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
ESCROW_TOKEN_CONTRACT=

# (Optional if ESCROW_IMPLEMENTATION=ourown. BP = 0..=10000 = 0..100% share of the
# requester in confiscate (rest goes to MARKETPLACE_WALLET). Default 7000 =
# 70% (compatible with DEFAULT_REQUESTER_CONFISCATION_SHARE already used today).
# MINIMUM ALLOWED on-chain P0-7 = 3000 (30%). Lower values return
# EscrowError::ShareBpBelowMinimum in the transaction (simulate catches it before submit).
ESCROW_CONFISCATE_REQUESTER_BP=7000

# ===== OUR OWN ESCROW (Option C / ADR 0002 P2.4) — OPTIONAL ENVS =====
# (Only if ESCROW_IMPLEMENTATION=ourown. All have sensible defaults in OurOwnEscrowContractClient.defaultRpcFor.)

# Override Stellar RPC URL. If omitted, uses defaults per network:
#   local     → http://localhost:8000/soroban/rpc
#   testnet   → https://soroban-testnet.stellar.org:443
#   pubnet    → https://soroban-rpc.mainnet.stellar.gateway.fm
STELLAR_RPC_URL=

# Override network passphrase. If omitted inferred from NETWORK=local/testnet/pubnet.
STELLAR_NETWORK_PASSPHRASE=

# Secret key (Ed25519) of MARKETPLACE_WALLET = release_signer.
# ⚠️  DANGER: DO NOT commit to repository! Never use .env.example with a filled value.
# Use only in controlled environments (do not use on local laptop without Vault).
# Equivalent to MARKETPLACE_SECRET_KEY in standard Stellar nomenclature.
# Required for: releaseMilestone / confiscate (backend signs on-chain).
# Without this value, calls throw an explanatory error requesting external signature.
MARKETPLACE_SECRET_KEY=

# Timeout ms in each Soroban RPC call. Default 15000 ms.
STELLAR_RPC_TIMEOUT_MS=15000

# Optional Trustless Work public key for signature verification of any
# incoming dispute/adjustment/chargeback webhooks coming from the SaaS Escrow
# side. The actual POST /webhooks/trustless-work endpoint doesn't exist yet in
# this codebase (P2 backlog); setting this key now guarantees the app will fail
# loudly on boot if you fat-finger a key shorter than 32 chars. Format can be
# either (a) raw base64 Ed25519 public key or (b) PEM/SPKI block (string
# starting with `-----BEGIN PUBLIC KEY-----`). The safetyFeatures parser only
# enforces length >= 32; the future middleware will validate algorithm-specific
# semantics. Setting this env var is **not** sufficient to enable webhook
# verification — the endpoint + middleware still need to be wired.
TRUSTLESS_WORK_WEBHOOK_PUBLIC_KEY=

# How often the Worker samples Redis Streams XLEN / XPENDING metrics and
# materializes them as Prometheus gauges (tg_stream_length, tg_stream_pending,
# tg_stream_pending_consumer). Numeric ms, minimum 1000. Default 5000 (5 s),
# as specified in ADR 0001 (§ Sampling path backlog). Workloads handling
# >1k events/s with a single consumer pair should raise this to 10000–15000
# to avoid unnecessary Redis round-trips on every 2nd tick.
OUTBOX_BACKLOG_SAMPLE_MS=5000

# Admin/marketplace account secret key (S...). Leave empty on local network
# to auto-generate + friendbot-fund a throwaway admin account on startup.
ADMIN_SECRET=
USDC_ISSUER=

# Set by scripts/deploy-registry.ts
# Official SDF Testnet Deploy Registry v2 (08/06/2026):
#   CAC752B34ZYHHDTSHDVVHY3IX2R2UQHAN4AY5B57NZUY23XCYIEXSGPP
# Explorer Link: https://stellar.expert/explorer/testnet/contract/CAC752B34ZYHHDTSHDVVHY3IX2R2UQHAN4AY5B57NZUY23XCYIEXSGPP
REGISTRY_CONTRACT_ID=

# Stellar public key (G...) that receives listing fees. Defaults to the
# ADMIN_SECRET account's public key if left blank.
# Official SDF Testnet Deploy Admin/Marketplace (08/06/2026):
#   GAE7YLEM2X2WJQVR6ZOM6TYTBRZ5Y7T3I2VZPN2XJKQSLH2C5CDPVLPI
# Explorer Link: https://stellar.expert/explorer/testnet/account/GAE7YLEM2X2WJQVR6ZOM6TYTBRZ5Y7T3I2VZPN2XJKQSLH2C5CDPVLPI
MARKETPLACE_WALLET=

# HMAC key (>=32 bytes, e.g. `openssl rand -base64 32`) binding the MPP
# Charge challenges POST /tasks issues to their contents. Required whenever
# NETWORK is testnet/pubnet (not used on `local`, where the listing fee is
# instead charged directly server-side via MppChargeService).
MPP_SECRET_KEY=

# Trustless Work escrow-as-a-service API key (https://trustlesswork.com).
# Required for EscrowService to create/manage bid-collateral escrows.
TRUSTLESS_WORK_API_KEY=

# OZ Channels API key (https://channels.openzeppelin.com/testnet/gen). Required
# to mount GET /executor/tasks/:taskId/result (x402-gated). Left unset, that
# route is skipped with a warning instead of blocking the rest of the app.
OZ_API_KEY=
X402_NETWORK=stellar:testnet
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
EXECUTOR_WALLET=
EXECUTOR_RESULT_PRICE=$0.05

# WASM hash of an already-deployed OpenZeppelin smart account contract
# (github.com/kalepail/smart-account-kit). Required by scripts/deploy-smart-account.ts;
# no such WASM ships in any published npm package, so this must be built and
# uploaded separately.
ACCOUNT_WASM_HASH=
# (Smoke-testnet and deploy scripts only. Requester's Ed25519 secret key (S...).
# SDF Testnet Test Wallet (08/06/2026):
#   Public: GBI6OZO2DO3QYOQETUJ2NFX4DI233L5ELRVFAZZMU4FWHDYMQM6BQVQ4
#   Explorer: https://stellar.expert/explorer/testnet/account/GBI6OZO2DO3QYOQETUJ2NFX4DI233L5ELRVFAZZMU4FWHDYMQM6BQVQ4
REQUESTER_SECRET=
# (Smoke-testnet and deploy scripts only. Executor's Ed25519 secret key (S...).
# SDF Testnet Test Wallet (08/06/2026):
#   Public: GDXAS2RYPIDZAYHWNJBTK7UQQ3LCHIN4QTC3KPNVXSWLCTQNREREKTTL
#   Explorer: https://stellar.expert/explorer/testnet/account/GDXAS2RYPIDZAYHWNJBTK7UQQ3LCHIN4QTC3KPNVXSWLCTQNREREKTTL
EXECUTOR_SECRET=
# Set by scripts/deploy-smart-account.ts
SMART_ACCOUNT_CONTRACT_ID=
# WASM-deployed spending-limit policy contract address, wired via a context
# rule in Sprint 18. Also not shipped in any package.
SPENDING_LIMIT_POLICY_ADDRESS=

# ==============================================================================
# PUBNET SAFETY GATE — P0-6 ADR 0003 (OUROWN-GATE 4 conditions)
# DO NOT activate DEBUG_UNSAFE in production/pubnet! On network=pubnet IT IS ALWAYS IGNORED.
# Activate all here + gates 1/2/3/4 validated in the createEscrowProvider factory.
# ==============================================================================

# LOCAL-ONLY bypass: ignored in NODE_ENV=production / network=pubnet.
# Use only during local development/testnet staging.
#DEBUG_UNSAFE_ENABLE_OWN_ESCROW_IMPL=true

# GATE 1/4: L2 contract security passed (npm run security:contracts-check RC=0)
# Set by CI/CD pipeline AFTER validation (build + clippy -Dwarnings + tests).
#ESCROW_SECURITY_L2_PASSED=true

# GATE 2/4: 2 devs INDEPENDENTLY SIGNED the manual L1 checklist (ADR 0003 §3)
# Different values (e.g.: emails or sha256 of merge commit).
#ESCROW_L1_SIGN_OFF_1=dev1@trustgate.app
#ESCROW_L1_SIGN_OFF_2=dev2@trustgate.app

# GATE 3/4: 2 INDEPENDENT external audits published
# sha256 of the reports (64 HEX chars), DIFFERENT from each other.
#ESCROW_AUDIT_SHA256_1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
#ESCROW_AUDIT_SHA256_2=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# GATE 4/4 FINAL: Feature flag per network.
ESCROW_OUROWN_PUBNET_ENABLED=false  # true → ENABLES on pubnet. All gates 1-3 MUST pass first!
ESCROW_OUROWN_ALLOW_STAGING=false   # true → Allows in local/testnet staging (gates 1-3 still mandatory).

# =============================================================================
# BLOCK N — TrustGate Escrow Contract Runtime (V14 integrated in app worker)
# =============================================================================

# Network: local | testnet | pubnet. Used by Stellar RPC, EscrowService, TTL Monitor.
#NETWORK=testnet

# Soroban contract ID (Option C) generated via deploy-escrow.ts. REQUIRED for all on-chain features.
#   Local standalone default: CATJ45W6...
#   Testnet: CD... (get from artifacts/contracts/escrow/deployed-testnet.json)
#ESCROW_CONTRACT_ID=CD...

# USDC issuer / token contract on Soroban (token.require_auth() required in initialize).
#ESCROW_TOKEN_CONTRACT=CC...USDC_ISSUER_SOROBAN_ID

# Marketplace wallet (release_signer judge). Receives ReleaseSigner + Marketplace roles in initialize 3 args.
#MARKETPLACE_WALLET=GA...MARKETPLACE_ADDRESS
#MARKETPLACE_SECRET_KEY=SC...SIGNER_KEY_ONLY_IN_LOCAL_STAGING

# Escrow TTL Monitor — AUTOMATICALLY integrated in app:3000/metrics if ESCROW_CONTRACT_ID is set.
# Disable ONLY if you are running scripts/ttl-monitor.ts as a separate standalone.
#DISABLE_TTL_MONITOR=false

# Pause flags (Big Red Buttons — Pauses OFF-CHAIN side mutation operations via API.
# Useful in incident: locks writes without needing to call contract pause on-chain.)
#PAUSE_ESCROW=false
#PAUSE_AUCTION=false
#PAUSE_REGISTRY=false
